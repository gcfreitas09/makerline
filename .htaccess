# Makerline — configuração da raiz do site.

# ---------------------------------------------------------------------------
# 1. A raiz do site é a landing page, nunca o app.
#
# Sem esta linha, quem decide o que "/" entrega é a DirectoryIndex padrão do
# servidor. Na configuração típica do Apache o index.php vem ANTES do
# index.html, então bastaria alguém criar um index.php na raiz pra landing
# sumir do ar sem ninguém encostar nela. Declarando explicitamente, "/" serve
# a landing e ponto final.
# ---------------------------------------------------------------------------
DirectoryIndex index.html

# Sem listagem de diretório em pastas que não têm index.
Options -Indexes

# ---------------------------------------------------------------------------
# 2. Cache dos estáticos.
#
# Os arquivos são versionados na URL (?v=20260731a), então o navegador só
# rebaixa quando a versão muda. Os HTML ficam de fora de propósito: precisam
# ser revalidados pra um deploy aparecer na hora.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # O service worker nunca pode ficar preso em cache, senão o push quebra.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 3. Compressão (o Cloudflare já faz, isto cobre acesso direto à origem).
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
